@@ -0,0 +1,63 @@
+"""Knowledge-page catalog: only metadata enters the Hermes prompt."""
+import json
+import threading
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+
+import pytest
+
+from hindsight_hermes.page_catalog import fetch_page_tree, render_page_index
+
+
+@pytest.fixture
+def tree_server():
+    received = []
+    tree = {"roots": [{"id": "f1", "kind": "folder", "name": "team", "children": [
+        {"id": "kp-b", "kind": "page", "name": "Zebra", "description": "second\nline", "body": "PRIVATE BODY", "children": []},
+        {"id": "kp-a", "kind": "page", "name": "Alpha", "description": "first guidance", "children": []},
+        {"id": "kp-c", "kind": "page", "name": "Credentials", "description": "private values", "tags": ["memory_type:credential"], "children": []},
+    ]}]}
+
+    class Handler(BaseHTTPRequestHandler):
+        def do_GET(self):
+            received.append((self.path, self.headers.get("Authorization")))
+            payload = json.dumps(tree).encode()
+            self.send_response(200)
+            self.send_header("Content-Type", "application/json")
+            self.send_header("Content-Length", str(len(payload)))
+            self.end_headers()
+            self.wfile.write(payload)
+
+        def log_message(self, *_args):
+            pass
+
+    server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
+    thread = threading.Thread(target=server.serve_forever, daemon=True)
+    thread.start()
+    try:
+        yield f"http://127.0.0.1:{server.server_port}", tree, received
+    finally:
+        server.shutdown()
+        server.server_close()
+        thread.join(timeout=2)
+
+
+def test_fetch_reads_only_tree_with_scoped_auth(tree_server):
+    url, tree, received = tree_server
+    assert fetch_page_tree(url + "/", "team", "test-key") == tree
+    assert received == [("/v1/default/banks/team/knowledge-base/tree", "Bearer test-key")]
+
+
+def test_index_is_sorted_bounded_and_excludes_page_bodies_and_sensitive_descriptions(tree_server):
+    _, tree, _ = tree_server
+    index = render_page_index(tree)
+    assert index.index("team/Alpha") < index.index("team/Credentials") < index.index("team/Zebra")
+    assert "team/Alpha — first guidance" in index
+    assert "team/Zebra — second line" in index
+    assert "team/Credentials" in index
+    assert "private values" not in index
+    assert "PRIVATE BODY" not in index and "kp-b" not in index
+    assert "These are page descriptions, not loaded page bodies" in index
+    assert render_page_index({"roots": []}) == ""
+    short = render_page_index(tree, max_chars=240, description_chars=8)
+    assert len(short) <= 240
+    assert "catalog truncated" in short
